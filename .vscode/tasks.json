{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build the module",
            "type": "shell",
            "command": "Invoke-Build Build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "Invoke-Build Test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$pester"]
        },
        {
            "label": "Clean generated files",
            "type": "shell",
            "command": "Invoke-Build Clean"
        }
    ],
    "inputs": [
        {
            "id": "TestTag",
            "description": "Pester test tags to include",
            "type": "promptString"
        }
    ]
}
